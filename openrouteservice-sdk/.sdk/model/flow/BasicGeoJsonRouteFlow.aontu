# BasicGeoJsonRouteFlow

main: kit: flow: BasicGeoJsonRouteFlow:
{
  entity: "geo_json_route",
  kind: "basic",
  name: "BasicGeoJsonRouteFlow",
  step: [
    {
      i: {
        ref: "geo_json_route_ref01"
      }

      m: {
        profile: "profile01"
      }

      o: "create"
    }

    {
      i: {
        ref: "geo_json_route_ref01",
        srcdatavar: "geo_json_route_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "geo_json_route01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-geo_json_route_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicGeoJsonRouteFlow"
}